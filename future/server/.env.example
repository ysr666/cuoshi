# Documentation only: supply all secrets through a real secrets manager.
# Do not copy these literal placeholders to a deployed environment.
CUOSHI_PRIVATE_EDGE_ACK=PRIVATE_EDGE_LOOPBACK_ONLY
CUOSHI_PRIVATE_PORT=18765
# Must match the separate schema where the seven reviewed migrations were run.
CUOSHI_PG_SCHEMA=cuoshi_prod
CUOSHI_WECHAT_APP_ID=wx_REPLACE_WITH_OFFICIAL_APPID
CUOSHI_WECHAT_APP_SECRET=REPLACE_WITH_WECHAT_APP_SECRET
CUOSHI_PG_BACKUP_URL=postgresql://restricted_backup_role:REPLACE@db.example:5432/cuoshi?sslmode=verify-full
CUOSHI_PG_IDENTITY_URL=postgresql://restricted_identity_role:REPLACE@db.example:5432/cuoshi?sslmode=verify-full
CUOSHI_PG_STAFF_URL=postgresql://restricted_staff_role:REPLACE@db.example:5432/cuoshi?sslmode=verify-full
CUOSHI_PG_CANCELLATION_URL=postgresql://restricted_cancellation_role:REPLACE@db.example:5432/cuoshi?sslmode=verify-full
# Each value below MUST be a different cryptographically secure 32-byte random hex string.
CUOSHI_BACKUP_SIGNING_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
CUOSHI_STAFF_SIGNING_KEY_HEX=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
CUOSHI_WECHAT_SUBJECT_PEPPER_HEX=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
CUOSHI_WECHAT_CODE_PEPPER_HEX=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
CUOSHI_LOGIN_PEER_HMAC_KEY_HEX=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
CUOSHI_EDGE_SHARED_SECRET_HEX=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
