# DOCUMENTATION ONLY: do not copy these PLACEHOLDERS into a running service.
# Create /etc/cuoshi/staff.env only after actual provisioning as root-owned 0600.
# No human employees. This service admits the ONE sole owner via password+TOTP.
# Three distinct ports: public API Node, owner Node, localhost owner Caddy gate.
CUOSHI_STAFF_EDGE_ACK=ISOLATED_STAFF_LOOPBACK_ONLY
CUOSHI_PRIVATE_PORT=18765
CUOSHI_STAFF_PORT=18766
CUOSHI_PG_SCHEMA=cuoshi_prod
# Separate, scoped PostgreSQL technical roles; NOT human employees.
CUOSHI_PG_STAFF_URL=postgresql://restricted_admin_role:REPLACE_ON_HOST@db.example.invalid:5432/cuoshi?sslmode=verify-full
CUOSHI_PG_REPORTING_URL=postgresql://restricted_reporting_role:REPLACE_ON_HOST@db.example.invalid:5432/cuoshi?sslmode=verify-full
# Obtain the six items below from your offline owner onboarding/secret manager.
CUOSHI_OWNER_ADMIN_ID=REPLACE_WITH_SOLE_OWNER_ID
CUOSHI_OWNER_PASSWORD_SCRYPT=REPLACE_WITH_SCRYPT_PASSWORD_HASH_RECORD
CUOSHI_OWNER_TOTP_SECRET=REPLACE_WITH_PRIVATE_BASE32_TOTP_SEED
CUOSHI_OWNER_LOGIN_PEER_KEY_HEX=REPLACE_WITH_64_HEX_OWNER_PEER_KEY
CUOSHI_STAFF_SIGNING_KEY_HEX=REPLACE_WITH_DIFFERENT_64_HEX_ADMIN_JWT_SIGNING_KEY
CUOSHI_STAFF_EDGE_SHARED_SECRET_HEX=REPLACE_WITH_DIFFERENT_64_HEX_ADMIN_RAW_EDGE_KEY
