# TEMPLATE: only enable on an approved mainland host with an independently
# authenticated maintenance-only PostgreSQL login. No public listener.
[Unit]
Description=Cuoshi v0.5 expire pseudonymous WeChat login windows
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cuoshi-maint
Group=cuoshi-maint
WorkingDirectory=/opt/cuoshi/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/cuoshi/maintenance.env
ExecStart=/usr/bin/node /opt/cuoshi/current/future/server/.private-build/future/server/src/privateMaintenance.js
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
