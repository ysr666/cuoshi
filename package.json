{
  "name": "cuoshi-uniapp",
  "version": "0.4.0-alpha.3",
  "private": true,
  "description": "Cuoshi cross-platform offline-first app alpha.2",
  "scripts": {
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:app": "uni -p app",
    "test:core": "node tests/check-core.mjs",
    "test:v04": "node tests/check-v04.mjs",
    "test:store": "node tests/check-store.mjs",
    "test": "npm run test:core && npm run test:v04 && npm run test:store",
    "typecheck": "vue-tsc --noEmit",
    "test:h5": "node tests/check-h5-flow.cjs",
    "test:h5:extended": "node tests/check-h5-extended.cjs",
    "test:h5:layout": "node tests/check-h5-layout.cjs",
    "test:h5:notes": "node tests/check-h5-notes-ux.cjs",
    "test:h5:polish": "node tests/check-h5-polish.cjs",
    "test:h5:typography": "node tests/check-h5-typography.cjs",
    "test:h5:refinement": "node tests/check-h5-refinement.cjs",
    "test:h5:feedback": "node tests/check-h5-feedback.cjs",
    "test:h5:audit": "node tests/check-h5-audit.cjs",
    "test:h5:date-boundaries": "node tests/check-h5-date-boundaries.cjs",
    "test:wechat:backup-bridge": "node tests/check-wechat-backup-bridge.cjs",
    "test:h5:release": "node tests/check-h5-release-readiness.cjs",
    "test:future:cloud": "node tests/check-future-cloud-contracts.mjs",
    "test:future:isolation": "node tests/check-future-cloud-isolation.mjs",
    "test:future:auth": "node tests/check-future-auth.mjs",
    "test:future:recovery": "node tests/check-future-cloud-recovery.mjs",
    "test:future:first-link": "node tests/check-future-initial-migration.mjs",
    "test:future:first-link-runtime": "node tests/check-future-first-link-runtime.mjs",
    "test:future:first-link-ui": "node tests/check-future-first-link-ui.mjs",
    "test:future:auto-sync": "node tests/check-future-automatic-sync.mjs",
    "test:future:client-adapters": "node tests/check-future-client-adapters.mjs",
    "test:future:backup-http": "node tests/check-future-backup-http.mjs",
    "test:future:account-http": "node tests/check-future-account-http.mjs",
    "test:future:wechat-session": "node tests/check-future-wechat-session.mjs",
    "typecheck:future:cloud-ui": "vue-tsc --noEmit -p future/tsconfig.ui.json",
    "build:future:cloud-ui": "vite build --config future/preview/vite.config.ts",
    "test:future:cloud-ui": "node tests/check-future-cloud-ui.cjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4080720251210001",
    "@dcloudio/uni-app-plus": "3.0.0-4080720251210001",
    "@dcloudio/uni-components": "3.0.0-4080720251210001",
    "@dcloudio/uni-h5": "3.0.0-4080720251210001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4080720251210001",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.19",
    "@dcloudio/vite-plugin-uni": "3.0.0-4080720251210001",
    "@types/node": "24.1.0",
    "@vue/runtime-core": "3.4.21",
    "playwright-core": "1.56.1",
    "typescript": "5.8.3",
    "vite": "5.2.8",
    "vue-tsc": "3.0.4"
  }
}
